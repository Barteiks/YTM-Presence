{
  "manifest_version": 3,
  "name": "YTM Presence",
  "version": "1.0",
  "description": "YTM Presence browser extension",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },

  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
	  "world": "MAIN"
    }
  ],

  "permissions": []
}